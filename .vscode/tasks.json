{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run PSP",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build_psp.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}